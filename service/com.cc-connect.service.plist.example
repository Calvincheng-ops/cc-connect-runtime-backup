<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cc-connect.service</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_ME/.local/lib/node_modules/cc-connect/bin/cc-connect</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/.cc-connect</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CC_LOG_FILE</key>
    <string>/tmp/cc-connect.log</string>
    <key>CC_LOG_MAX_SIZE</key>
    <string>10485760</string>
    <key>PATH</key>
    <string>/Users/REPLACE_ME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <true/>
  </dict>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
